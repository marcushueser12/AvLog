# Gemini API Key (required for backend)
GEMINI_API_KEY=your_gemini_api_key_here

# Backend API URL (optional - defaults to http://localhost:3001)
# For production, set this to your deployed backend URL
VITE_API_URL=http://localhost:3001

# Server Port (optional - defaults to 3001)
PORT=3001

# Environment (development, production)
NODE_ENV=development

# Allowed Origins for CORS (production only)
# Comma-separated list of allowed origins, e.g., https://yourdomain.com,https://www.yourdomain.com
# Leave empty or unset to allow all origins (development only)
ALLOWED_ORIGINS=

# Supabase Configuration (required for user accounts and verified pages)
# Get these from your Supabase project settings: https://app.supabase.com/project/YOUR_PROJECT/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Admin Secret Token (required for granting credits)
# Generate a secure random token, e.g., using: openssl rand -hex 32
ADMIN_SECRET_TOKEN=your-secret-admin-token-here

# Stripe Configuration (required for payment processing)
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_... (or sk_live_... for production)
STRIPE_WEBHOOK_SECRET=whsec_... (from Stripe Dashboard → Webhooks)

# Frontend URL (for Stripe redirects)
# Set this to your production frontend URL
FRONTEND_URL=https://your-frontend.vercel.app

# Clerk (React/Vite) – client-side only
# Get from https://dashboard.clerk.com/last-active?path=api-keys (choose React, copy Publishable Key)
# Store real key only in .env.local; .gitignore excludes .env* so do not commit real values.
VITE_CLERK_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Clerk – server-side only (for backend session exchange / linking Supabase users)
# Same dashboard: copy Secret Key. Required only if you implement Clerk → Supabase session exchange.
CLERK_SECRET_KEY=YOUR_SECRET_KEY
